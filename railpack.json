{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "python": "3.13",
    "node": "22"
  },
  "steps": {
    "build": {
      "commands": [
        "chmod +x ./build.sh && ./build.sh"
      ]
    }
  },
  "deploy": {
    "startCommand": "gunicorn config.wsgi:application --bind 0.0.0.0:$PORT"
  }
}
