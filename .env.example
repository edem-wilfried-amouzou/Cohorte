# Copie ce fichier en ".env" puis ajuste les valeurs.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-moi-avec-une-longue-valeur-aleatoire
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# En production (DEBUG=0), renseigne l'origine HTTPS, ex : https://groupes.mondomaine.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Mets 1 si ton serveur est derrière un proxy HTTPS (Nginx, Caddy, Render...)
DJANGO_BEHIND_PROXY=0
# En local, laisse DATABASE_URL vide pour utiliser db.sqlite3.
# En production, colle ici l'URL pooled PostgreSQL de Neon dans les variables du fournisseur.
DATABASE_URL=
DB_CONN_MAX_AGE=60

# --- Documents (Cloudflare R2, facultatif en local) ---
# Laisse USE_R2_STORAGE=0 pour garder les fichiers dans MEDIA_ROOT en développement.
# En production, active R2 seulement après avoir créé le bucket et les clés Cloudflare.
USE_R2_STORAGE=0
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Sécurité ---
# Nombre de proxys de confiance devant l'app (Render = 1, local = 0). Sert au limiteur de requêtes par IP.
TRUSTED_PROXY_COUNT=0
# À activer seulement si le trafic de l’application passe uniquement par le proxy Cloudflare (pas DNS seul).
TRUST_CLOUDFLARE_HEADERS=0
# URL de l'admin (évite /admin/). Ex : gestion-x7k
DJANGO_ADMIN_URL=admin
# Si défini, l'inscription demande ce code d'invitation. Laisse vide pour une inscription libre.
SIGNUP_INVITE_CODE=

# --- E-mail (réinitialisation du mot de passe) ---
# Sans EMAIL_HOST, les e-mails s'affichent dans la console.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=1
DEFAULT_FROM_EMAIL=Cohorte <contact@django-admin.com>

# --- Supervision (facultatif) ---
SENTRY_DSN=
