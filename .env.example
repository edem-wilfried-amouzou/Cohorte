# Copie ce fichier en ".env" puis ajuste les valeurs.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-moi-avec-une-longue-valeur-aleatoire
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# En production (DEBUG=0), renseigne l'origine HTTPS, ex : https://groupes.mondomaine.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Mets 1 si ton serveur est derrière un proxy HTTPS (Nginx, Caddy, Render...)
DJANGO_BEHIND_PROXY=0
